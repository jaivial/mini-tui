{
  "name": "mini-tui",
  "version": "0.35.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "screenshots": "MINITUI_CAPTURE=1 bun test scripts/capture-scenes.test.tsx && python3 scripts/render-screenshots.py",
    "benchmark:tui": "bun scripts/benchmark-tui-parser.ts",
    "sync-skills": "bun scripts/sync-skills.ts",
    "postinstall": "bun scripts/sync-skills.ts || true",
    "web": "bun run web:build && bun src/web/serve.ts",
    "web:serve": "bun src/web/serve.ts",
    "web:build": "cd web && bun run build",
    "web:dev": "cd web && bun run dev",
    "web:check": "cd web && bun run check"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
