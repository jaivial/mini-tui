[Unit]
Description=mini-tui local semantic retrieval from neo4j-rust
After=network.target mini-tui-orchestration-graph.service
[Service]
User=jaime
WorkingDirectory=/home/jaime/mini-tui-wa
Environment=OMP_NUM_THREADS=2
ExecStart=/usr/bin/python3 /home/jaime/mini-tui-wa/scripts/orchestration_rag.py
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
