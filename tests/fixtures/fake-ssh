#!/usr/bin/env bash
# A fake `ssh` for the remote-session tests: it stands in for the TRANSPORT, not for the agent.
#
# It exists so `SessionManager` can be driven end to end — `startRemoteRun` really spawns this,
# really feeds it the remote script on stdin, and really reads its stream-json back — without a
# host to ssh to. Everything the server does around it (one turn at a time, the queue, stopping,
# the exit card) is therefore the real code path rather than a mocked transport.
#
# `$QA_SSH_LOG` names the log this run appends its lifecycle to. It is per test on purpose: a
# shared file races a stub that is still dying when the next test truncates it, and one leaked
# line silently moves a later test's process count.
# `$QA_HOLD_MS` is how long the "agent" thinks for, so a test can send a prompt into a live turn.
printf '%s START\n' "$$" >> "$QA_SSH_LOG"
trap 'printf "%s STOP\n" "$$" >> "$QA_SSH_LOG"; exit 130' INT TERM

cat > /dev/null            # the remote script arrives on stdin

echo '{"type":"init","session_id":"s","model":"stub","cwd":"/remote"}'
sleep 0.2
echo '{"type":"assistant","text":"working"}'

# Backgrounded: a foreground `sleep` would make bash defer the INT/TERM trap until it returned,
# so a stopped run would look like it ignored the signal for the whole hold.
# Seconds with a decimal because `$((ms / 1000))` is integer division: 900 ms would become a
# zero-second hold and the turn would end before the test could look at it.
sleep "$(awk -v ms="${QA_HOLD_MS:-600}" 'BEGIN{printf "%.3f", ms/1000}')" &
HOLD=$!
wait "$HOLD" || exit 130

echo '{"type":"assistant","text":"answered"}'
echo '{"type":"result","subtype":"success","is_error":false,"num_turns":1,"api_calls":1,"cost_usd":0.002,"duration_ms":1,"result":"the answer","session_id":"s","exit_status":"Submitted"}'
printf '%s EXIT\n' "$$" >> "$QA_SSH_LOG"
