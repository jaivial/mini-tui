    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.18.0",
    "playwright-core": "^1.63.0",
    "svelte": "^5",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4",
    "typescript": "5.9",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
