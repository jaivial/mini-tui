{
  "name": "mini-tui-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landing page and docs for mini-tui, prerendered to static HTML.",
  "scripts": {
    "dev": "vite dev --port 4320",
    "build": "vite build",
    "preview": "vite preview --port 4321",
